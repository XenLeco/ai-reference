{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/coder-fast",
  "instructions": ["docs/CONTRIBUTING.md"],
  "agent": {
    "build": { "model": "litellm/coder-fast" },
    "plan": { "model": "litellm/reasoning-max" },
    "explore": { "model": "litellm/coder-local" }
  },
  "permission": {
    "bash": {
      "npm test*": "allow",
      "npm run lint*": "allow",
      "make test*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "tools": {
    "context7*": false
  }
}
