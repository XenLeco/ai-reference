# Copy to .env (git-ignored). Enterprise: inject these from the vault instead.

# --- gateway itself ---------------------------------------------------------
# Master key: starts the server, creates virtual keys. Never configure it in a client.
LITELLM_MASTER_KEY=sk-master-change-me
# Salt for encrypting stored credentials. Set once, never change after first start.
LITELLM_SALT_KEY=change-me-to-32-random-characters
# Admin UI login
UI_USERNAME=admin
UI_PASSWORD=change-me
# Postgres password (compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=litellm
# Log level: DEBUG for troubleshooting
LITELLM_LOG=INFO

# --- providers --------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hosted open models (optional; used by qwen3-coder-480b)
OPENROUTER_API_KEY=
# Local models. Native Ollama on the same host from Docker: host.docker.internal.
# Bundled Ollama (--profile local): http://ollama:11434. Remote GPU box: its LAN address.
OLLAMA_API_BASE=http://host.docker.internal:11434
# vLLM server (optional; see commented entries in the config)
VLLM_API_BASE=http://gpu-box:8000/v1

# --- enterprise only --------------------------------------------------------
SLACK_WEBHOOK_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
GATEWAY_HOSTNAME=gateway.example.internal
